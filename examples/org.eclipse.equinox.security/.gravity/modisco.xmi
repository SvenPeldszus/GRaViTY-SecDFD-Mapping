                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.16" text="the responsibility of the consumer to manually encode such strings before"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.16" text="attempting to obtain corresponding nodes from secure preferences."/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.16" text="&lt;p>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.16" text="Internally, the class uses a subset of JIT encoding. The forward slashes "/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.16" text="and backward slashes are encoded."/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.16" text="&lt;/p>&lt;p>"/>
