                            <qualifier package="//@ownedElements.0"/>
                          </qualifier>
                        </qualifier>
                      </qualifier>
                    </fragments>
                  </fragments>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text=". To recap in a short form, preferences "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="provide a tree. Nodes on that tree can be used to specify context. For instance, "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="root node could have a child node called &quot;cvs&quot; to store information related to CVS "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="integration."/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/p>&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="Each node can have a map of keys with associated values. For instance, to store "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="password for the CVS repository located on eclipse.org we could use the following "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="code:"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;pre>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="ISecurePreferences root = SecurePreferencesFactory.getDefault();"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="ISecurePreferences node = root.node(&quot;cvs/eclipse.org&quot;);"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="node.put(&quot;password&quot;, myPassword, true);"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/pre>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="This interface has the following differences from the "/>
                  <fragments xsi:type="java:TagElement" originalCompilationUnit="//@compilationUnits.43" tagName="@link">
                    <fragments xsi:type="java:TypeAccess" type="//@ownedElements.0/@ownedPackages.1/@ownedPackages.2/@ownedPackages.0/@ownedElements.0">
                      <qualifier xsi:type="java:PackageAccess" package="//@ownedElements.0/@ownedPackages.1/@ownedPackages.2/@ownedPackages.0">
                        <qualifier package="//@ownedElements.0/@ownedPackages.1/@ownedPackages.2">
                          <qualifier package="//@ownedElements.0/@ownedPackages.1">
                            <qualifier package="//@ownedElements.0"/>
