                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/p>&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="Also note that secure preferences only intended to store relatively small size data, such as "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="passwords. If you need to securely store large objects, consider encrypting such objects in "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="a symmetric way using randomly generated password and use secure preferences to store the password. "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/p>&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="If secure preferences were modified, the framework will automatically save them on shutdown."/>
