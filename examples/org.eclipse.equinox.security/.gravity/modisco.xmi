                      <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.2" text="Hence, aside from implementation details, no priority information is specified by the order"/>
                      <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.2" text="of config files. In this implementation we add customer's config file to the end of the list."/>
                      <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.2" text="This method substitutes default login configuration:"/>
                      <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.2" text="Configuration Inquiries -> ConfigurationFederator ->"/>
                      <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.2" text="1) Extension Point supplied config providers;"/>
                      <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.2" text="2) default Java config provider (&quot;login.configuration.provider&quot;)"/>
                    </tags>
