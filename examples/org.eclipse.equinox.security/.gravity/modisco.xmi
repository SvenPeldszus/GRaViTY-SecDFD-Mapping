                        </qualifier>
                      </qualifier>
                    </fragments>
                  </fragments>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text=":"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;ul>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;li>get...() and put...() methods throw StorageException&lt;/li>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;li>put...() methods have an extra argument bEncrypt&lt;/li>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;li>Methods that used to throw BackingStoreException will be throwing more detailed StorageException&lt;/li> "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;li>Navigation on preferences tree will return ISecurePreferences, as opposing to Preferences&lt;/li>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;li>flush() throws IOException&lt;/li>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;li>sync() method is removed&lt;/li>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/ul> "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/p>&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="On the keyring side, when adding a key to the node, you can ask framework to encrypt it. Framework"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="will lazily acquire password from password provider and use it to encrypt all new  entries added "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="to the secure preferences tree in this session. "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="&lt;/p>&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.43" text="It is worthwhile to reiterate that same limitations as "/>
                  <fragments xsi:type="java:TagElement" originalCompilationUnit="//@compilationUnits.43" tagName="@link">
                    <fragments xsi:type="java:TypeAccess" type="//@ownedElements.0/@ownedPackages.1/@ownedPackages.2/@ownedPackages.0/@ownedElements.0">
