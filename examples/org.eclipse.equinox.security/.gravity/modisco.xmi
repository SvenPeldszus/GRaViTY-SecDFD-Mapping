            <ownedElements xsi:type="org.gravity.modisco:MClass" originalCompilationUnit="//@compilationUnits.44" name="SecurePreferencesFactory" usagesInImports="//@compilationUnits.47/@imports.1 //@compilationUnits.48/@imports.2 //@compilationUnits.31/@imports.7" usagesInTypeAccess="//@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.1/@ownedPackages.1/@ownedPackages.0/@ownedElements.1/@comments.0/@tags.0/@fragments.6/@fragments.0/@qualifier //@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.1/@ownedPackages.1/@ownedPackages.0/@ownedElements.2/@bodyDeclarations.2/@comments.0/@tags.1/@fragments.0/@qualifier //@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.2/@ownedPackages.0/@ownedElements.4/@bodyDeclarations.7/@body/@statements.0/@fragments.0/@initializer/@expression //@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.2/@ownedPackages.0/@ownedElements.4/@bodyDeclarations.8/@body/@statements.0/@fragments.0/@initializer/@expression" dependencies="//@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.2/@ownedElements.13">
              <comments xsi:type="java:Javadoc" originalCompilationUnit="//@compilationUnits.44" content="/**&#xD;&#xA; * Use this class to access secure preferences. Secure preferences allow storage of&#xD;&#xA; * data in an encrypted form.  &#xD;&#xA; * &lt;p>&#xD;&#xA; * This class is not intended to be instantiated or extended by clients.&#xD;&#xA; * &lt;/p>&#xD;&#xA; * @noinstantiate This class is not intended to be instantiated by clients.&#xD;&#xA; */" prefixOfParent="true">
                <tags originalCompilationUnit="//@compilationUnits.44">
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="Use this class to access secure preferences. Secure preferences allow storage of"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="data in an encrypted form.  "/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;p>"/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="This class is not intended to be instantiated or extended by clients."/>
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;/p>"/>
                </tags>
                <tags originalCompilationUnit="//@compilationUnits.44" tagName="@noinstantiate">
                  <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text=" This class is not intended to be instantiated by clients."/>
                </tags>
              </comments>
              <modifier visibility="public" inheritance="final"/>
              <bodyDeclarations xsi:type="org.gravity.modisco:MMethodDefinition" originalCompilationUnit="//@compilationUnits.44" name="getDefault" usages="//@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.2/@ownedPackages.0/@ownedElements.4/@bodyDeclarations.7/@body/@statements.0/@fragments.0/@initializer //@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.2/@ownedPackages.0/@ownedElements.4/@bodyDeclarations.8/@body/@statements.0/@fragments.0/@initializer" mMethodInvocations="//@ownedElements.0/@ownedPackages.0/@ownedPackages.0/@ownedPackages.1/@ownedPackages.1/@ownedElements.2/@bodyDeclarations.0/@body/@statements.0/@expression" mSignature="//@mMethodNames.327/@mSignatures.2">
                <comments xsi:type="java:Javadoc" originalCompilationUnit="//@compilationUnits.44" content="/**&#xD;&#xA;&#x9; * Returns default secure preferences.&#xD;&#xA;&#x9; * &lt;p>&#xD;&#xA;&#x9; * The framework will attempt to open secure preferences in a user-specific location. &#xD;&#xA;&#x9; * As a result, the information stored can be shared among all programs run by the user. &#xD;&#xA;&#x9; * The location is determined as follows:&#xD;&#xA;&#x9; * &lt;ol>&#xD;&#xA;&#x9; * &lt;li>&amp;quot;-equinox.keyring&amp;quot; command line arguments&lt;/li>&#xD;&#xA;&#x9; * &lt;li>Java's &amp;quot;user.home&amp;quot; environment variable. On Windows system it usually &#xD;&#xA;&#x9; * corresponds to the %USERPROFILE% environment variable or determined as the parent of&#xD;&#xA;&#x9; * user's desktop folder. On Unix Java usually determines it from user's entry&#xD;&#xA;&#x9; * in the password file (commonly this corresponds to $HOME environment variable);&lt;/li>&#xD;&#xA;&#x9; * &lt;li>if it fails, preferences will use configuration location of the current Eclipse &#xD;&#xA;&#x9; * instance.&lt;/li>&#xD;&#xA;&#x9; * &lt;/ol>&#xD;&#xA;&#x9; * &lt;/p>&#xD;&#xA;&#x9; * @return default instance of secure preferences, &lt;code>null&lt;/code> if application&#xD;&#xA;&#x9; * was unable to create secure preferences using default location&#xD;&#xA;&#x9; */" prefixOfParent="true">
                  <tags originalCompilationUnit="//@compilationUnits.44">
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="Returns default secure preferences."/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;p>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="The framework will attempt to open secure preferences in a user-specific location. "/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="As a result, the information stored can be shared among all programs run by the user. "/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="The location is determined as follows:"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;ol>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;li>&amp;quot;-equinox.keyring&amp;quot; command line arguments&lt;/li>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;li>Java's &amp;quot;user.home&amp;quot; environment variable. On Windows system it usually "/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="corresponds to the %USERPROFILE% environment variable or determined as the parent of"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="user's desktop folder. On Unix Java usually determines it from user's entry"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="in the password file (commonly this corresponds to $HOME environment variable);&lt;/li>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;li>if it fails, preferences will use configuration location of the current Eclipse "/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="instance.&lt;/li>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;/ol>"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="&lt;/p>"/>
                  </tags>
                  <tags originalCompilationUnit="//@compilationUnits.44" tagName="@return">
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text=" default instance of secure preferences, &lt;code>null&lt;/code> if application"/>
                    <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.44" text="was unable to create secure preferences using default location"/>
                  </tags>
                </comments>
                <modifier visibility="public" static="true"/>
