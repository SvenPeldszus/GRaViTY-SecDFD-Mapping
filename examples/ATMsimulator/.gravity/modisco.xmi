          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.3" text="sessions which then use it to gain access to the component parts."/>
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.3" text="This is an active class - when an instance of the class is created,"/>
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.3" text="a thread is executed that actually runs the system."/>
