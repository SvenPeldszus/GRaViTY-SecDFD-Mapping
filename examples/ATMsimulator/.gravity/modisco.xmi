      <comments xsi:type="java:Javadoc" originalCompilationUnit="//@compilationUnits.17" content="/** Representations of a message from the ATM to the bank.&#xD; *  Messages to the bank use a fixed format with fixed slots, not all of which&#xD; *  pertain to any given type of transaction.  Each type of transaction creates&#xD; *  one or more subclasses using the slots that it needs, and supplying appropriate&#xD; *  &quot;not needed&quot; values for the rest.&#xD; */" prefixOfParent="true">
        <tags originalCompilationUnit="//@compilationUnits.17">
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.17" text="Representations of a message from the ATM to the bank."/>
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.17" text="Messages to the bank use a fixed format with fixed slots, not all of which"/>
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.17" text="pertain to any given type of transaction.  Each type of transaction creates"/>
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.17" text="one or more subclasses using the slots that it needs, and supplying appropriate"/>
          <fragments xsi:type="java:TextElement" originalCompilationUnit="//@compilationUnits.17" text="&quot;not needed&quot; values for the rest."/>
        </tags>
      </comments>
